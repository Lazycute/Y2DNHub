PORT=4000
# Comma-separated list of allowed front-end origins
CLIENT_ORIGIN=http://localhost:5173,https://lazycute.github.io
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed into the admin area (must also exist in Supabase Auth)
ADMIN_EMAILS=you@example.com
